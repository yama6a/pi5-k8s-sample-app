{
  // The shared presets hold the grouping, automerge and digest-pinning rules. The cron in
  // .github/workflows/renovate.yaml sets the cadence, so a manual workflow_dispatch works too.
  // Every automerged bump cuts a release and deploys it. Add minimumReleaseAge to slow that down.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>yama6a/gha:default.json5",
    "github>yama6a/gha:go.json5",
  ],

  packageRules: [
    {
      description: "keep testcontainers majors together, because the modules must match the core module",
      matchPackageNames: [
        "github.com/testcontainers/testcontainers-go{,/**}",
      ],
      matchUpdateTypes: ["major"],
      groupName: "testcontainers (major)",
    },
    // Newer go-yit needs go.yaml.in/yaml/v4, which yaml-jsonpath, used by oapi-codegen, does not build
    // against. Drop this once yaml-jsonpath ships a yaml/v4 build.
    {
      description: "hold go-yit at the yaml.v3 revision that yaml-jsonpath builds against",
      matchPackageNames: ["github.com/dprotaso/go-yit"],
      enabled: false,
    },
  ],
}
