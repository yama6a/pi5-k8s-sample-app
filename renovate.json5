{
  // Opens dependency-update PRs for every pin in the repo. Which manager owns what:
  //   gomod           go.mod + go.sum, including the `go` directive
  //   dockerfile      the build and runtime base images in .build/Dockerfile
  //   github-actions  the action pins in .github/workflows/*.yaml
  // Cadence is the cron in .github/workflows/renovate.yaml, not an internal `schedule`, so a manual
  // workflow_dispatch works too. Docs: README.md, "Dependency updates".
  //
  // The shared presets carry the grouping, automerge and digest-pinning rules. Only what is specific
  // to this repo lives below.
  // WARNING: the combined non-major PR automerges, and merging to main runs build-push.yaml, which cuts
  // a new GitHub release and pushes a new ghcr.io image tag. Every automerged bump therefore produces a
  // release. Accepted for a sample app; add minimumReleaseAge to slow it down.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>yama6a/gha:default.json5",
    "github>yama6a/gha:go.json5",
  ],

  packageRules: [
    // MAJOR updates get their own PR each, which is Renovate's default. The testcontainers modules are
    // the exception: they must move in lockstep with the core module.
    {
      description: "keep testcontainers majors together (modules must match the core module version)",
      matchPackageNames: [
        "github.com/testcontainers/testcontainers-go{,/**}",
      ],
      matchUpdateTypes: ["major"],
      groupName: "testcontainers (major)",
    },
    {
      // `make ci` regenerates api/server.gen.go and then builds against the fresh output, but the regenerated
      // file is never committed by CI. A codegen bump that changes the output leaves the committed
      // server.gen.go stale and green, so it gets a reviewed PR instead of an automerge.
      description: "oapi-codegen: no automerge (CI does not detect generated-code drift)",
      matchPackageNames: ["github.com/oapi-codegen/oapi-codegen/v2"],
      automerge: false,
    },
  ],
}
